{
  "document": "MealUp C6.3 — G4 Geometry Contract",
  "version": "1.0",
  "status": "G4_PASS_CONTRACT_FROZEN",
  "scope": "Defines geometry mathematics, layer semantics, alpha-normalized scaling, z-order, vessel occlusion requirements, Gauge separation, mapping render behavior and QA hard-stops. G5 supplies exact per-vessel/cardinality slot templates.",
  "coordinate_system": {
    "storage_unit": "normalized_0_1",
    "logical_reference_canvas": 1000,
    "origin": "top_left",
    "x_axis": "right",
    "y_axis": "down",
    "rotation_positive": "clockwise_degrees",
    "pixel_coordinates_in_contract": "FORBIDDEN",
    "non_uniform_scaling": "FORBIDDEN",
    "mirror_or_flip": "FORBIDDEN"
  },
  "alpha_normalized_transform": {
    "anchor_definition": "Desired center of the visible alpha bbox, not center of 512x512 source canvas.",
    "span_definition": "Target maximum visible alpha extent relative to the active reference frame.",
    "formula": [
      "bbox_extent = max(alpha_bbox_width_norm, alpha_bbox_height_norm)",
      "raw_image_side = target_span * reference_short_side / bbox_extent",
      "raw_image_center = target_anchor - center_offset_norm * raw_image_side",
      "rotation occurs around visible alpha-bbox center"
    ],
    "why": "Equalizes perceived size despite transparent padding and prevents two 512x512 PNGs from appearing arbitrarily different in scale."
  },
  "canonical_scene_defaults": {
    "purpose": "Neutral base scene before G6 surface profiles.",
    "scene_safe_margin": 0.03,
    "vessel_anchor": [
      0.46,
      0.61
    ],
    "vessel_outer_max_span": 0.82,
    "gauge_anchor": [
      0.82,
      0.2
    ],
    "gauge_max_span": 0.27,
    "gauge_may_overlap_vessel_outer": true,
