    },
    "BUTTER_SAGE": {
      "render_base": "BUTTER",
      "strategy": "VIRTUAL_SINGLE_SOURCE_PLUS_MATRIX_COMPONENTS",
      "suppress_logical_if_present": [
        "BUTTER"
      ],
      "reason": "Butter is the visual carrier; herb semantics do not spawn a duplicate object."
    },
    "RAGU": {
      "render_base": "ROSA_SAUCE",
      "strategy": "VIRTUAL_SINGLE_SOURCE_PLUS_MATRIX_COMPONENTS",
      "suppress_logical_if_present": [
        "TOMATO_SAUCE"
      ],
      "reason": "Ragù occupies one sauce layer; meat already represented by matrix components must not be duplicated."
    },
    "SMOOTHIE": {
      "render_base": "GREEK_YOGURT",
      "strategy": "VIRTUAL_CONTENT_IN_FORCED_VESSEL",
      "force_vessel_id": "VESSEL_GLASS",
      "suppress_logical_if_present": [],
      "reason": "Smoothie is liquid content; canonical vessel is glass, not a plate."
    },
    "TONNATO_SAUCE": {
      "render_base": "MAYONNAISE",
      "strategy": "VIRTUAL_SINGLE_SOURCE_PLUS_MATRIX_COMPONENTS",
      "suppress_logical_if_present": [
        "MAYONNAISE"
      ],
      "reason": "One sauce visual layer; tuna/anchovy ingredients remain separate only when the matrix requires them."
    },
    "YOGURT_BOWL": {
      "render_base": "GREEK_YOGURT",
      "strategy": "VIRTUAL_CONTENT_IN_MATRIX_VESSEL",
      "required_vessel_id": "VESSEL_BOWL",
      "suppress_logical_if_present": [
        "GREEK_YOGURT",
        "YOGURT"
      ],
      "reason": "The bowl is supplied by the vessel system; yogurt content is represented once."
    }
